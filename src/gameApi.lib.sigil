λacknowledgeBrowserShell(autosave:String)=>µAppBootstrap=browserShell(acknowledgePendingInterrupts(loadAutosaveState(autosave)))

λacknowledgePendingInterrupts(state:µGameState)=>µGameState match shellStageIsMission(state){
  true=>match state.activeMission.interrupts{
    []=>state|
    _=>•simulation.acknowledgeInterrupts(state)
  }|
  false=>state
}

λadvanceBrowserShell(autosave:String)=>µAppBootstrap=browserShell(advanceToCheckpoint(loadAutosaveState(autosave)))

λadvanceToCheckpoint(state:µGameState)=>µGameState match shellStageIsMission(state){
  true=>match state.activeMission.interrupts{
    []=>•simulation.resumeUntilInterrupt(
      browserAdvanceLimit(),
      state
    )|
    _=>state
  }|
  false=>state
}

λalarmLevelDisplay(alarm:µAlarmLevel)=>String=alarmLevelName(alarm)
  ++" "
  ++alarmLevelTier(alarm)

λalarmLevelName(alarm:µAlarmLevel)=>String match alarm{
  µAlarmCounterOperatorTrace()=>"Counter-operator trace"|
  µAlarmLocal()=>"Local response"|
  µAlarmLockdown()=>"Lockdown"|
  µAlarmNormal()=>"Normal"|
  µAlarmSearch()=>"Search"|
  µAlarmSuspicion()=>"Suspicion"|
  µAlarmTacticalResponse()=>"Tactical response"
}

λalarmLevelTier(alarm:µAlarmLevel)=>String match alarm{
  µAlarmCounterOperatorTrace()=>"3 / 6"|
  µAlarmLocal()=>"5 / 6"|
  µAlarmLockdown()=>"6 / 6"|
  µAlarmNormal()=>"1 / 6"|
  µAlarmSearch()=>"4 / 6"|
  µAlarmSuspicion()=>"2 / 6"|
  µAlarmTacticalResponse()=>"6 / 6"
}

λappendBrowserEvent(message:String,state:µGameState)=>µGameState={
  activeMission:state.activeMission,
  campaign:state.campaign,
  eventLog:state.eventLog⧺[{
    message:message,
    turn:state.turn
  }],
  missionConfig:state.missionConfig,
  schemaVersion:state.schemaVersion,
  seed:state.seed,
  shellStage:state.shellStage,
  turn:state.turn
}

λappendQueuedBrowserOrder(command:µBrowserOrderCommand,order:µRobotOrder,state:µGameState)=>µGameState=appendBrowserEvent(
  "Operator queued order: "
    ++browserCommandLabel(command)
    ++".",
  updateMissionOrders(
    state.activeMission.orders⧺[order],
    state
  )
)

λautosavePayload(state:µGameState)=>String=•saveCodecs.stringifySaveFile(•saveApi.createSaveFile(
  gameVersion(),
  autosaveSavedAt(),
  state
))

λautosaveSavedAt()=>String="2026-05-04T16:00:00Z"

λboardSummary(state:µGameState)=>µBoardSummary={
  height:state.activeMission.facility.height,
  tiles:boardTileSummaries(state.activeMission.facility.tiles),
  width:state.activeMission.facility.width
}

λboardTileKindLabel(kind:µFacilityTileKind)=>String match kind{
  µDuctTile()=>"duct"|
  µDoorTile(_)=>"door"|
  µEntryTile()=>"entry"|
  µFloorTile()=>"floor"|
  µObjectiveTile(_)=>"objective"|
  µRelayTile()=>"relay"|
  µTerminalTile(_)=>"terminal"|
  µWallTile()=>"wall"
}

λboardTileLabel(kind:µFacilityTileKind)=>String match kind{
  µDuctTile()=>"Access duct"|
  µDoorTile(_)=>"Security door"|
  µEntryTile()=>"Entry point"|
  µFloorTile()=>"Operational floor"|
  µObjectiveTile(_)=>"Mission objective"|
  µRelayTile()=>"Relay node"|
  µTerminalTile(_)=>"Network terminal"|
  µWallTile()=>"Structural wall"
}

λboardTileSummaries(tiles:[µFacilityTile])=>[µBoardTileSummary]=tiles map (λ(tile:µFacilityTile)=>µBoardTileSummary={
  kind:boardTileKindLabel(tile.kind),
  label:boardTileLabel(tile.kind),
  position:tile.position,
  revealed:tile.revealed,
  walkable:tile.walkable
})

λbootstrap()=>µAppBootstrap=browserShell(bootstrapState())

λbootstrapState()=>µGameState=•gameState.initialGameState()

λbrowserAdvanceLimit()=>Int=32

λbrowserCommandLabel(command:µBrowserOrderCommand)=>String match command{
  µBrowserAbortMission(robotId)=>robotId++" -> abort_mission"|
  µBrowserExtract(robotId)=>robotId++" -> extract"|
  µBrowserFollow(
  robotId,
  targetRobotId
)=>robotId
    ++" -> follow "
    ++targetRobotId|
  µBrowserHack(robotId)=>robotId++" -> hack"|
  µBrowserHold(robotId)=>robotId++" -> hold"|
  µBrowserInteract(robotId)=>robotId++" -> interact"|
  µBrowserMove(
  robotId,
  position
)=>robotId
    ++" -> move_to "
    ++positionLabel(position)|
  µBrowserReturnToRelay(robotId)=>robotId++" -> return_to_relay"|
  µBrowserScan(robotId)=>robotId++" -> scan"
}

λbrowserControls(state:µGameState)=>µControlSummary={
  canAcknowledge:canAcknowledgeInterrupts(state),
  canAdvance:canAdvanceSimulation(state),
  canQueueOrders:canQueueOrders(state),
  canReset:true,
  status:controlStatus(state)
}

λbrowserRobotOrder(command:µBrowserOrderCommand,state:µGameState)=>Result[
  µRobotOrder,
  String
] match queueableMissionState(state){
  Ok(_)=>match command{
    µBrowserAbortMission(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>Ok(queuedRobotOrder(
        µAbortMission(),
        robot.id
      ))|
      Err(message)=>Err(message)
    }|
    µBrowserExtract(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateExtractOrder(
        robot,
        state
      ){
        Ok(order)=>Ok(queuedRobotOrder(
          order,
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserFollow(
  robotId,
  targetRobotId
)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateFollowTarget(
        robot,
        state,
        targetRobotId
      ){
        Ok(target)=>Ok(queuedRobotOrder(
          µFollow(target),
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserHack(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateHackOrder(
        robot,
        state
      ){
        Ok(order)=>Ok(queuedRobotOrder(
          order,
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserHold(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>Ok(queuedRobotOrder(
        µHold(),
        robot.id
      ))|
      Err(message)=>Err(message)
    }|
    µBrowserInteract(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateInteractOrder(state){
        Ok(order)=>Ok(queuedRobotOrder(
          order,
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserMove(
  robotId,
  position
)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateMoveTarget(
        position,
        state
      ){
        Ok(targetPosition)=>Ok(queuedRobotOrder(
          µMoveTo(targetPosition),
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserReturnToRelay(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateRelayOrder(state){
        Ok(order)=>Ok(queuedRobotOrder(
          order,
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }|
    µBrowserScan(robotId)=>match resolveBrowserRobot(
      robotId,
      state
    ){
      Ok(robot)=>match validateScanOrder(
        robot,
        state
      ){
        Ok(order)=>Ok(queuedRobotOrder(
          order,
          robot.id
        ))|
        Err(message)=>Err(message)
      }|
      Err(message)=>Err(message)
    }
  }|
  Err(message)=>Err(message)
}

λbrowserShell(state:µGameState)=>µAppBootstrap={
  autosave:autosavePayload(state),
  board:boardSummary(state),
  controls:browserControls(state),
  debrief:debriefSummary(state),
  eventLog:state.eventLog,
  interrupts:interruptsForShell(state.activeMission.interrupts),
  mission:missionSummary(state),
  packets:•packetGenerator.generatePackets(state),
  robots:robotSummaries(state.activeMission.robots),
  shell:shellSummary(state),
  tagline:"Illegal operators, disposable hardware, and no punishment for thinking.",
  title:"Remote Ops"
}

λcanAcknowledgeInterrupts(state:µGameState)=>Bool=shellStageIsMission(state)
  and missionIsInProgress(state.activeMission.status)
  and hasPendingInterrupts(state)

λcanAdvanceSimulation(state:µGameState)=>Bool match shellStageIsMission(state){
  true=>match hasPendingInterrupts(state){
    true=>false|
    false=>match hasQueuedOrders(state){
      true=>missionIsInProgress(state.activeMission.status)|
      false=>false
    }
  }|
  false=>false
}

λcanQueueOrders(state:µGameState)=>Bool match shellStageIsMission(state){
  true=>match missionIsInProgress(state.activeMission.status){
    true=>match hasPendingInterrupts(state){
      true=>false|
      false=>true
    }|
    false=>false
  }|
  false=>false
}

λcontractIdValue(contractId:µContractId)=>String match contractId{
  µContractId(value)=>value
}

λcontractLobbyRisk(contract:µContractSummary)=>String match contract.contractId{
  µContractId("helixgrid-battery-recovery")=>"Balanced opposition"|
  µContractId("morrow-audit-lift")=>"Camera-heavy interior"|
  µContractId("nightglass-dawn-snatch")=>"Fast patrol rotations"|
  _=>"Unrated"
}

λcontractLobbySummaryText(contract:µContractSummary)=>String match contract.contractId{
  µContractId("helixgrid-battery-recovery")=>"Cold-storage lab access with a predictable patrol lattice and standard counter-operator trace."|
  µContractId("morrow-audit-lift")=>"Audit storage turnover opens a narrow theft window, but the surveillance mesh is denser than usual."|
  µContractId("nightglass-dawn-snatch")=>"Nightglass is moving the sample before dawn, forcing a tighter extraction clock and faster patrol loops."|
  _=>"Deterministic contract package ready for selection."
}

λcontractOptionSummary(contract:µContractSummary,selectedContractId:String)=>µContractLobbySummary={
  contractId:contractIdValue(contract.contractId),
  corporation:corporationDisplayName(contract.corporation),
  label:contract.label,
  objective:objectiveKindDisplay(contract.objective),
  risk:contractLobbyRisk(contract),
  selected:contractIdValue(contract.contractId)=selectedContractId,
  summary:contractLobbySummaryText(contract)
}

λcontrolStatus(state:µGameState)=>String match state.shellStage{
  µShellContractLobby()=>"Select a contract, review any stored autosaves, and move into briefing when the crew is ready."|
  µShellMissionConfig()=>"Tune the entry plan, review the deterministic preview, and launch when the operation looks right."|
  µShellMissionLive()=>match state.activeMission.status{
    µMissionAborted()=>"Mission aborted. Review the debrief or return to briefing for another run."|
    µMissionExtracted()=>"Mission complete. Review the debrief, export packets, or return to briefing for another branch."|
    µMissionFailed(reason)=>"Mission failed: "
      ++reason
      ++". Review the debrief or return to briefing to try again."|
    µMissionInProgress()=>match hasPendingInterrupts(state){
      true=>"Interrupts are waiting. Acknowledge them before advancing the simulation."|
      false=>match hasQueuedOrders(state){
        true=>"Advance the deterministic simulation until the next interrupt or status change. Queue more orders from the browser shell if needed."|
        false=>"No queued orders remain. Queue more orders from the browser shell or return to briefing to replay the opener."
      }
    }
  }
}

λcorporationDisplayName(corporationId:µCorporationId)=>String match corporationId{
  µCorporationId("helixgrid")=>"HelixGrid"|
  µCorporationId("morrow-dynamics")=>"Morrow Dynamics"|
  µCorporationId("nightglass")=>"Nightglass Systems"|
  µCorporationId(value)=>value
}

λdebriefEventMessages(state:µGameState)=>[String]=takeStrings(
  3,
  reverseStrings(state.eventLog map (λ(entry:µEventEntry)=>String=entry.message))
)

λdebriefNextStep(state:µGameState)=>String match state.activeMission.status{
  µMissionAborted()=>"Replay the deterministic opener or restore a saved branch if you want to inspect a different outcome."|
  µMissionExtracted()=>"Replay the deterministic opener, export the packets below, or restore a saved branch to compare another plan."|
  µMissionFailed(_)=>"Reset to replay the opener, or restore a saved autosave to test a different order stack."|
  µMissionInProgress()=>match hasPendingInterrupts(state){
    true=>"Acknowledge the pending interrupts before issuing the next wave of browser orders."|
    false=>match hasQueuedOrders(state){
      true=>"Advance to the next interrupt or add another queued order before committing to the branch."|
      false=>"Queue fresh orders or restore a saved branch before advancing the deterministic shell again."
    }
  }
}

λdebriefOutcome(status:µMissionStatus)=>String match status{
  µMissionAborted()=>"Mission aborted"|
  µMissionExtracted()=>"Mission complete"|
  µMissionFailed(_)=>"Mission failed"|
  µMissionInProgress()=>"Mission still live"
}

λdebriefSummary(state:µGameState)=>µDebriefSummary={
  isTerminal:missionIsTerminal(state.activeMission.status),
  keyEvents:debriefEventMessages(state),
  nextStep:debriefNextStep(state),
  outcome:debriefOutcome(state.activeMission.status),
  summary:debriefSummaryText(state),
  tone:debriefTone(state.activeMission.status)
}

λdebriefSummaryText(state:µGameState)=>String match state.activeMission.status{
  µMissionAborted()=>"Operators scrubbed the "
    ++corporationDisplayName(state.activeMission.contract.corporation)
    ++" "
    ++objectiveSiteLabel(state.activeMission.facility.rooms)
    ++" run before extraction."|
  µMissionExtracted()=>state.activeMission.contract.label
    ++" concluded with a clean extraction from the "
    ++objectiveSiteLabel(state.activeMission.facility.rooms)
    ++"."|
  µMissionFailed(reason)=>"The "
    ++corporationDisplayName(state.activeMission.contract.corporation)
    ++" "
    ++objectiveSiteLabel(state.activeMission.facility.rooms)
    ++" run collapsed: "
    ++reason|
  µMissionInProgress()=>corporationDisplayName(state.activeMission.contract.corporation)
    ++" "
    ++objectiveSiteLabel(state.activeMission.facility.rooms)
    ++" recovery is still live and waiting on the next operator decision."
}

λdebriefTone(status:µMissionStatus)=>String match status{
  µMissionAborted()=>"warning"|
  µMissionExtracted()=>"success"|
  µMissionFailed(_)=>"error"|
  µMissionInProgress()=>"info"
}

λentryPlanEffects(entryPlan:µMissionEntryPlan)=>[String] match entryPlan{
  µEntryBadgeSpoof()=>[
    "Keeps the opener at 07:42 with suspicion-tier alarm pressure.",
    "Seeds the queue with Gecko recon, Mira hold, Atlas movement, and a relay refresh.",
    "Best fit when you want the familiar prototype opener before improvising."
  ]|
  µEntryDockBreach()=>[
    "Starts Atlas on the loading line with exposure already elevated to 16.",
    "Counter-operator trace opens hot at 53% to trade stealth for immediate board position.",
    "Queue prioritizes heavy movement and shadow support over early scanning."
  ]|
  µEntryDuctInsertion()=>[
    "Drops the opener to 07:39 and lowers trace to 24% for a quieter first branch.",
    "Stages Gecko and Wisp deeper in the access ducts for faster recon coverage.",
    "Queue favors reconnaissance and terminal pressure before the heavy unit commits."
  ]
}

λentryPlanFromId(entryPlanId:String)=>µMissionEntryPlan match entryPlanId{
  "badge-spoof"=>µEntryBadgeSpoof()|
  "dock-breach"=>µEntryDockBreach()|
  "duct-insertion"=>µEntryDuctInsertion()|
  _=>µEntryBadgeSpoof()
}

λentryPlanId(entryPlan:µMissionEntryPlan)=>String match entryPlan{
  µEntryBadgeSpoof()=>"badge-spoof"|
  µEntryDockBreach()=>"dock-breach"|
  µEntryDuctInsertion()=>"duct-insertion"
}

λentryPlanLabel(entryPlan:µMissionEntryPlan)=>String match entryPlan{
  µEntryBadgeSpoof()=>"Service badge spoof"|
  µEntryDockBreach()=>"Loading dock breach"|
  µEntryDuctInsertion()=>"Maintenance duct insertion"
}

λentryPlanSummary(entryPlan:µMissionEntryPlan)=>String match entryPlan{
  µEntryBadgeSpoof()=>"Balanced opener with stable positions, standard trace, and the familiar seeded order queue."|
  µEntryDockBreach()=>"Louder breach profile that pushes Atlas forward immediately and accepts a hotter trace baseline."|
  µEntryDuctInsertion()=>"Quieter infiltration that starts the recon package deeper inside the facility and earlier on the clock."
}

λfindAvailableContract(contractId:String,state:µGameState)=>Option[µContractSummary]=§list.find(
  λ(contract:µContractSummary)=>Bool=contractIdValue(contract.contractId)=contractId,
  state.campaign.availableContracts
)

λfindFacilityTile(position:µPosition,state:µGameState)=>Option[µFacilityTile]=§list.find(
  λ(tile:µFacilityTile)=>Bool=tile.position=position,
  state.activeMission.facility.tiles
)

λfindMissionObjectiveTile(state:µGameState)=>Option[µFacilityTile]=§list.find(
  λ(tile:µFacilityTile)=>Bool match tile.kind{
    µObjectiveTile(objectiveId)=>objectiveId=state.activeMission.objective.objectiveId|
    _=>false
  },
  state.activeMission.facility.tiles
)

λfindMissionRelayTile(state:µGameState)=>Option[µFacilityTile]=§list.find(
  λ(tile:µFacilityTile)=>Bool match tile.kind{
    µRelayTile()=>true|
    _=>false
  },
  state.activeMission.facility.tiles
)

λfindMissionTerminalTile(state:µGameState)=>Option[µFacilityTile]=§list.find(
  λ(tile:µFacilityTile)=>Bool match tile.kind{
    µTerminalTile(_)=>true|
    _=>false
  },
  state.activeMission.facility.tiles
)

λgameVersion()=>String="prototype"

λhasLabRoom(rooms:[µRoomState])=>Bool match §list.find(
  λ(room:µRoomState)=>Bool match room.roomKind{
    µLab()=>true|
    _=>false
  },
  rooms
){
  Some(_)=>true|
  None()=>false
}

λhasPendingInterrupts(state:µGameState)=>Bool match state.activeMission.interrupts{
  []=>false|
  _=>true
}

λhasQueuedOrders(state:µGameState)=>Bool match state.activeMission.orders{
  []=>false|
  _=>true
}

λhasRobotPart(part:µRobotPartType,robot:µRobotState)=>Bool match §list.find(
  λ(robotPart:µRobotPartType)=>Bool=robotPart=part,
  robot.parts
){
  Some(_)=>true|
  None()=>false
}

λhydrateBrowserShell(autosave:String)=>µAppBootstrap=browserShell(loadAutosaveState(autosave))

λinterruptsForShell(interrupts:[µInterrupt])=>[String]=interrupts map (λ(interrupt:µInterrupt)=>String=•packetGenerator.interruptLabel(interrupt))

λlaunchBrowserMission(autosave:String)=>µAppBootstrap=browserShell(launchBrowserMissionState(loadAutosaveState(autosave)))

λlaunchBrowserMissionState(state:µGameState)=>µGameState=replaceShellStage(
  µShellMissionLive(),
  state
)

λloadAutosaveState(autosave:String)=>µGameState match •saveCodecs.parseSaveFile(autosave){
  Ok(saveFile)=>•saveApi.loadGameState(saveFile)|
  Err(_)=>match •saveCodecs.parseLegacySaveFile(autosave){
    Ok(saveFile)=>•gameState.upgradeLegacyGameState(saveFile.state)|
    Err(_)=>bootstrapState()
  }
}

λmissionClockLabel(clock:Int)=>String="07:"++twoDigit(clock)

λmissionConfigOptionSummary(entryPlan:µMissionEntryPlan,selectedEntryPlan:µMissionEntryPlan)=>µMissionConfigOptionSummary={
  effects:entryPlanEffects(entryPlan),
  id:entryPlanId(entryPlan),
  label:entryPlanLabel(entryPlan),
  selected:entryPlan=selectedEntryPlan,
  summary:entryPlanSummary(entryPlan)
}

λmissionIsInProgress(status:µMissionStatus)=>Bool match status{
  µMissionInProgress()=>true|
  _=>false
}

λmissionIsTerminal(status:µMissionStatus)=>Bool match status{
  µMissionInProgress()=>false|
  _=>true
}

λmissionStatusDisplay(status:µMissionStatus)=>String match status{
  µMissionAborted()=>"Aborted"|
  µMissionExtracted()=>"Extracted"|
  µMissionFailed(reason)=>"Failed: "++reason|
  µMissionInProgress()=>"In progress"
}

λmissionSummary(state:µGameState)=>µMissionSummary={
  alarmLevel:alarmLevelDisplay(state.activeMission.alarmLevel),
  corporation:corporationDisplayName(state.activeMission.contract.corporation),
  exposure:state.activeMission.exposure,
  missionClock:missionClockLabel(state.activeMission.missionClock),
  missionStatus:missionStatusDisplay(state.activeMission.status),
  objective:objectiveSummary(state.activeMission),
  objectiveStatus:objectiveStatusDisplay(state.activeMission.objective),
  pendingInterrupts:#state.activeMission.interrupts,
  queuedOrders:#state.activeMission.orders,
  siteLabel:objectiveSiteLabel(state.activeMission.facility.rooms),
  trace:state.activeMission.trace,
  turn:state.turn
}

λobjectiveKindDisplay(kind:µObjectiveKind)=>String match kind{
  µPhotographPrototypeBattery()=>"Photograph prototype battery"|
  µStealPrototypeBattery()=>"Steal prototype battery"
}

λobjectiveSiteLabel(rooms:[µRoomState])=>String match hasLabRoom(rooms){
  true=>"cold-storage lab"|
  false=>"facility"
}

λobjectiveStatusDisplay(objective:µObjectiveState)=>String match objective.extracted{
  true=>"Extracted"|
  false=>match objective.securedBy{
    Some(robotId)=>robotIdDisplay(robotId)++" secured the package"|
    None()=>match objective.located{
      true=>"Located"|
      false=>"Unlocated"
    }
  }
}

λobjectiveSummary(mission:µMissionState)=>String=mission.contract.label
  ++" from the "
  ++objectiveSiteLabel(mission.facility.rooms)
  ++"."

λopenMissionConfig(autosave:String)=>µAppBootstrap=browserShell(openMissionConfigState(loadAutosaveState(autosave)))

λopenMissionConfigState(state:µGameState)=>µGameState=resetOperationStage(
  µShellMissionConfig(),
  state
)

λpacketCount()=>Int=•packetGenerator.packetCount(bootstrapState())

λpositionLabel(position:µPosition)=>String=§string.intToString(position.x)
  ++","
  ++§string.intToString(position.y)

λqueueBrowserOrder(autosave:String,command:µBrowserOrderCommand)=>µAppBootstrap=browserShell(queueBrowserOrderState(
  command,
  loadAutosaveState(autosave)
))

λqueueBrowserOrderState(command:µBrowserOrderCommand,state:µGameState)=>µGameState match browserRobotOrder(
  command,
  state
){
  Ok(order)=>appendQueuedBrowserOrder(
    command,
    order,
    state
  )|
  Err(message)=>appendBrowserEvent(
    "Order rejected: "
      ++browserCommandLabel(command)
      ++" | "
      ++message,
    state
  )
}

λqueueableMissionState(state:µGameState)=>Result[
  µGameState,
  String
] match shellStageIsMission(state){
  true=>match missionIsInProgress(state.activeMission.status){
    true=>match hasPendingInterrupts(state){
      true=>Err("Acknowledge interrupts before queuing new orders.")|
      false=>Ok(state)
    }|
    false=>Err("Mission is no longer in progress.")
  }|
  false=>Err("Launch the mission from briefing before queuing browser orders.")
}

λqueuedRobotOrder(order:µOrder,robotId:µRobotId)=>µRobotOrder={
  assignedRobot:robotId,
  order:order,
  status:µOrderQueued()
}

λreplaceShellStage(stage:µShellStage,state:µGameState)=>µGameState={
  activeMission:state.activeMission,
  campaign:state.campaign,
  eventLog:state.eventLog,
  missionConfig:state.missionConfig,
  schemaVersion:state.schemaVersion,
  seed:state.seed,
  shellStage:stage,
  turn:state.turn
}

λresetBrowserShell()=>µAppBootstrap=browserShell(bootstrapState())

λresetOperationStage(stage:µShellStage,state:µGameState)=>µGameState=•gameState.operationState(
  state.campaign,
  state.missionConfig,
  state.activeMission.contract,
  stage
)

λresolveBrowserRobot(robotId:String,state:µGameState)=>Result[
  µRobotState,
  String
] match •simulation.findRobot(
  µRobotId(robotId),
  state.activeMission.robots
){
  Some(robot)=>Ok(robot)|
  None()=>Err("Unknown robot '"
    ++robotId
    ++"'.")
}

λreturnToContractLobby(autosave:String)=>µAppBootstrap=browserShell(returnToContractLobbyState(loadAutosaveState(autosave)))

λreturnToContractLobbyState(state:µGameState)=>µGameState=resetOperationStage(
  µShellContractLobby(),
  state
)

λreturnToMissionConfig(autosave:String)=>µAppBootstrap=browserShell(returnToMissionConfigState(loadAutosaveState(autosave)))

λreturnToMissionConfigState(state:µGameState)=>µGameState=resetOperationStage(
  µShellMissionConfig(),
  state
)

λreverseStrings(lines:[String])=>[String]=lines reduce (λ(reversed:[String],line:String)=>[String]=[line]⧺reversed) from []

λrobotArchetypeDisplay(archetype:µRobotArchetype)=>String match archetype{
  µAtlasBreacher()=>"Atlas Breacher"|
  µGeckoMicrocrawler()=>"Gecko Microcrawler"|
  µMiraServiceAndroid()=>"Mira Service Android"|
  µWispRelayDrone()=>"Wisp Relay Drone"
}

λrobotCount()=>Int=•gameState.rosterCount(bootstrapState())

λrobotIdDisplay(robotId:µRobotId)=>String match robotId{
  µRobotId(value)=>value
}

λrobotSignalDisplay(archetype:µRobotArchetype,signal:Int)=>String match archetype{
  µWispRelayDrone()=>match signal≥70{
    true=>"Relay online"|
    false=>"Unstable"
  }|
  _=>match signal≥75{
    true=>"Stable"|
    false=>match signal≥60{
      true=>"Steady"|
      false=>"Unstable"
    }
  }
}

λrobotSummaries(robots:[µRobotState])=>[µRobotSummary]=robots map (λ(robot:µRobotState)=>µRobotSummary={
  archetype:robotArchetypeDisplay(robot.archetype),
  battery:robot.battery,
  id:robotIdDisplay(robot.id),
  locationLabel:robot.locationLabel,
  name:robot.name,
  position:robot.position,
  signal:robotSignalDisplay(
    robot.archetype,
    robot.signal
  )
})

λselectBrowserContract(autosave:String,contractId:String)=>µAppBootstrap=browserShell(selectBrowserContractState(
  contractId,
  loadAutosaveState(autosave)
))

λselectBrowserContractState(contractId:String,state:µGameState)=>µGameState match findAvailableContract(
  contractId,
  state
){
  Some(contract)=>•gameState.operationState(
    state.campaign,
    •gameState.defaultMissionConfig(),
    contract,
    µShellContractLobby()
  )|
  None()=>state
}

λsetBrowserEntryPlan(autosave:String,entryPlanId:String)=>µAppBootstrap=browserShell(setBrowserEntryPlanState(
  entryPlanId,
  loadAutosaveState(autosave)
))

λsetBrowserEntryPlanState(entryPlanId:String,state:µGameState)=>µGameState=•gameState.operationState(
  state.campaign,
  {entryPlan:entryPlanFromId(entryPlanId)},
  state.activeMission.contract,
  µShellMissionConfig()
)

λshellStageId(stage:µShellStage)=>String match stage{
  µShellContractLobby()=>"lobby"|
  µShellMissionConfig()=>"config"|
  µShellMissionLive()=>"mission"
}

λshellStageIsMission(state:µGameState)=>Bool match state.shellStage{
  µShellMissionLive()=>true|
  _=>false
}

λshellStageSummaryText(state:µGameState)=>String match state.shellStage{
  µShellContractLobby()=>"Review available contracts, compare operator risk, and step into briefing once the crew commits."|
  µShellMissionConfig()=>"Choose the entry plan, inspect the deterministic preview, and launch when the operation feels right."|
  µShellMissionLive()=>match state.activeMission.status{
    µMissionInProgress()=>"The crew is in the field. Queue high-level orders, work the interrupt queue, or fall back to briefing."|
    _=>"Mission thread complete. Review the debrief, export packets, or return to briefing for another branch."
  }
}

λshellStageTitle(stage:µShellStage)=>String match stage{
  µShellContractLobby()=>"Operation lobby"|
  µShellMissionConfig()=>"Mission briefing"|
  µShellMissionLive()=>"Live mission"
}

λshellSummary(state:µGameState)=>µShellSummary={
  activeStage:shellStageId(state.shellStage),
  configOptions:[
    missionConfigOptionSummary(
      µEntryBadgeSpoof(),
      state.missionConfig.entryPlan
    ),
    missionConfigOptionSummary(
      µEntryDuctInsertion(),
      state.missionConfig.entryPlan
    ),
    missionConfigOptionSummary(
      µEntryDockBreach(),
      state.missionConfig.entryPlan
    )
  ],
  contractOptions:state.campaign.availableContracts map (λ(contract:µContractSummary)=>µContractLobbySummary=contractOptionSummary(
    contract,
    contractIdValue(state.activeMission.contract.contractId)
  )),
  selectedConfigId:entryPlanId(state.missionConfig.entryPlan),
  selectedContractId:contractIdValue(state.activeMission.contract.contractId),
  stageSummary:shellStageSummaryText(state),
  stageTitle:shellStageTitle(state.shellStage)
}

λtakeStrings(limit:Int,lines:[String])=>[String] match limit{
  0=>[]|
  _=>match lines{
    []=>[]|
    [
  head,
  .tail
]=>[head]⧺takeStrings(
      limit-1,
      tail
    )
  }
}

λtwoDigit(value:Int)=>String match value<10{
  true=>"0"++§string.intToString(value)|
  false=>§string.intToString(value)
}

λupdateMissionOrders(orders:[µRobotOrder],state:µGameState)=>µGameState={
  activeMission:{
    alarmLevel:state.activeMission.alarmLevel,
    contract:state.activeMission.contract,
    exposure:state.activeMission.exposure,
    facility:state.activeMission.facility,
    interrupts:state.activeMission.interrupts,
    missionClock:state.activeMission.missionClock,
    objective:state.activeMission.objective,
    orders:orders,
    robots:state.activeMission.robots,
    status:state.activeMission.status,
    trace:state.activeMission.trace
  },
  campaign:state.campaign,
  eventLog:state.eventLog,
  missionConfig:state.missionConfig,
  schemaVersion:state.schemaVersion,
  seed:state.seed,
  shellStage:state.shellStage,
  turn:state.turn
}

λvalidateExtractOrder(robot:µRobotState,state:µGameState)=>Result[
  µOrder,
  String
] match state.activeMission.objective.securedBy{
  Some(owner)=>match owner=robot.id{
    true=>Ok(µExtract())|
    false=>Err("Objective is secured by "
      ++robotIdDisplay(owner)
      ++".")
  }|
  None()=>Err("Secure the objective before extracting.")
}

λvalidateFollowTarget(robot:µRobotState,state:µGameState,targetRobotId:String)=>Result[
  µRobotId,
  String
] match robot.id=µRobotId(targetRobotId){
  true=>Err("Robots cannot follow themselves.")|
  false=>match resolveBrowserRobot(
    targetRobotId,
    state
  ){
    Ok(targetRobot)=>Ok(targetRobot.id)|
    Err(message)=>Err(message)
  }
}

λvalidateHackOrder(robot:µRobotState,state:µGameState)=>Result[
  µOrder,
  String
] match hasRobotPart(
  µBasicHackingModule(),
  robot
){
  true=>match findMissionTerminalTile(state){
    Some(tile)=>match tile.kind{
      µTerminalTile(terminalId)=>Ok(µHack(terminalId))|
      _=>Err("Mission has no accessible terminal target.")
    }|
    None()=>Err("Mission has no accessible terminal target.")
  }|
  false=>Err(robot.name++" lacks a hacking module.")
}

λvalidateInteractOrder(state:µGameState)=>Result[
  µOrder,
  String
] match state.activeMission.objective.located{
  true=>match state.activeMission.objective.securedBy{
    Some(owner)=>Err("Objective is already secured by "
      ++robotIdDisplay(owner)
      ++".")|
    None()=>match findMissionObjectiveTile(state){
      Some(_)=>Ok(µInteract(state.activeMission.objective.objectiveId))|
      None()=>Err("Mission objective target is unavailable.")
    }
  }|
  false=>Err("Locate the objective before interacting with it.")
}

λvalidateMoveTarget(position:µPosition,state:µGameState)=>Result[
  µPosition,
  String
] match findFacilityTile(
  position,
  state
){
  Some(tile)=>match tile.walkable{
    true=>Ok(position)|
    false=>Err("Move target "
      ++positionLabel(position)
      ++" is not walkable.")
  }|
  None()=>Err("Move target "
    ++positionLabel(position)
    ++" is not part of the mission map.")
}

λvalidateRelayOrder(state:µGameState)=>Result[
  µOrder,
  String
] match findMissionRelayTile(state){
  Some(_)=>Ok(µReturnToRelay())|
  None()=>Err("Mission has no relay anchor.")
}

λvalidateScanOrder(robot:µRobotState,state:µGameState)=>Result[
  µOrder,
  String
] match hasRobotPart(
  µFiberCamera(),
  robot
){
  true=>match state.activeMission.objective.located{
    true=>Err("Objective is already located.")|
    false=>Ok(µScan())
  }|
  false=>Err(robot.name++" lacks a fiber camera.")
}
