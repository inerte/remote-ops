λdoorPosition(seed:Int)=>µPosition match facilityVariant(seed){
  0=>{
    x:6,
    y:2
  }|
  1=>{
    x:7,
    y:1
  }|
  2=>{
    x:5,
    y:2
  }|
  _=>{
    x:5,
    y:2
  }
}

λfacilityConnectivityValid(seed:Int)=>Bool=inBounds(doorPosition(seed))
  and inBounds(objectiveTilePosition(seed))
  and roomCount(seed)=7

λfacilityVariant(seed:Int)=>Int=seed%3

λgenerateFacilityState(seed:Int)=>µFacilityState={
  height:7,
  rooms:generatedRooms(seed),
  security:generatedSecurity(seed),
  tiles:generatedTiles(seed),
  width:10
}

