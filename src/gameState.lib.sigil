λcampaignWithDefaultContracts(campaign:µCampaignState)=>µCampaignState={
  availableContracts:defaultContracts(),
  completedContracts:campaign.completedContracts,
  heat:campaign.heat,
  warehouse:campaign.warehouse
}

λcontractBaseSeed(contract:µContractSummary)=>Int match contract.contractId{
  µContractId("helixgrid-battery-recovery")=>1337|
  µContractId("morrow-audit-lift")=>1338|
  µContractId("nightglass-dawn-snatch")=>1339|
  _=>1337
}

λcontractOperationMessage(contract:µContractSummary)=>String match contract.contractId{
  µContractId("helixgrid-battery-recovery")=>"Mission package assembled for HelixGrid battery recovery."|
  µContractId("morrow-audit-lift")=>"Mission package assembled for Morrow Dynamics audit-lift."|
  µContractId("nightglass-dawn-snatch")=>"Mission package assembled for Nightglass dawn-window snatch."|
  _=>"Mission package assembled for the selected operation."
}

λdefaultContracts()=>[µContractSummary]=[
  helixgridContract(),
  morrowContract(),
  nightglassContract()
]

λdefaultInventory()=>[µInventoryItem]=[
  {
    label:"Battery pack",
    partType:µBatteryPack(),
    quantity:2
  },
  {
    label:"Signal relay",
    partType:µSignalRelay(),
    quantity:1
  },
  {
    label:"Spoofed service badge",
    partType:µSpoofedServiceBadge(),
    quantity:1
  }
]

λdefaultMissionConfig()=>µMissionConfigState={entryPlan:µEntryBadgeSpoof()}

λdefaultOrders()=>[µRobotOrder]=[
  queuedOrder(
    µScan(),
    µRobotId("gecko-1")
  ),
  queuedOrder(
    µHold(),
    µRobotId("mira-1")
  ),
  queuedOrder(
    µMoveTo({
      x:0,
      y:5
    }),
    µRobotId("atlas-1")
  ),
  queuedOrder(
    µReturnToRelay(),
    µRobotId("wisp-1")
  )
]

λdefaultRobots()=>[µRobotState]=badgeSpoofRobots()

λdockBreachOrders()=>[µRobotOrder]=[
  queuedOrder(
    µMoveTo({
      x:1,
      y:5
    }),
    µRobotId("atlas-1")
  ),
  queuedOrder(
    µFollow(µRobotId("atlas-1")),
    µRobotId("mira-1")
  ),
  queuedOrder(
    µHold(),
    µRobotId("gecko-1")
  ),
  queuedOrder(
    µReturnToRelay(),
    µRobotId("wisp-1")
  )
]

