    parts:[
      µFiberCamera(),
      µBatteryPack()
    ],
    payload:0,
    position:{
      x:4,
      y:1
    },
    signal:58
  },
  {
    archetype:µMiraServiceAndroid(),
    battery:81,
    damage:0,
    id:µRobotId("mira-1"),
    locationLabel:"Service corridor C4",
    name:"Mira",
    parts:[
      µSpoofedServiceBadge(),
      µBasicHackingModule()
    ],
    payload:0,
    position:{
      x:2,
      y:3
    },
    signal:86
  },
  {
    archetype:µAtlasBreacher(),
    battery:100,
    damage:0,
    id:µRobotId("atlas-1"),
    locationLabel:"Loading dock A6",
    name:"Atlas",
    parts:[
      µArmorPlate(),
