λentryPlanEventMessage(entryPlan:µMissionEntryPlan)=>String match entryPlan{
  µEntryBadgeSpoof()=>"Relay network seeded and remote units staged."|
  µEntryDuctInsertion()=>"Maintenance ducts spoofed and recon drones slipped under the first sweep."|
  µEntryDockBreach()=>"Loading dock distraction staged before the heavy breach."
}

λentryPlanExposure(entryPlan:µMissionEntryPlan)=>Int match entryPlan{
  µEntryBadgeSpoof()=>12|
  µEntryDuctInsertion()=>9|
  µEntryDockBreach()=>16
}

λentryPlanMissionClock(entryPlan:µMissionEntryPlan)=>Int match entryPlan{
  µEntryBadgeSpoof()=>42|
  µEntryDuctInsertion()=>39|
  µEntryDockBreach()=>45
}

λentryPlanOrders(entryPlan:µMissionEntryPlan)=>[µRobotOrder] match entryPlan{
  µEntryBadgeSpoof()=>defaultOrders()|
  µEntryDuctInsertion()=>ductInsertionOrders()|
  µEntryDockBreach()=>dockBreachOrders()
}

λentryPlanRobots(entryPlan:µMissionEntryPlan)=>[µRobotState] match entryPlan{
  µEntryBadgeSpoof()=>badgeSpoofRobots()|
  µEntryDuctInsertion()=>ductInsertionRobots()|
  µEntryDockBreach()=>dockBreachRobots()
}

λentryPlanSeedOffset(entryPlan:µMissionEntryPlan)=>Int match entryPlan{
  µEntryBadgeSpoof()=>0|
  µEntryDuctInsertion()=>1|
  µEntryDockBreach()=>2
}

λentryPlanTrace(entryPlan:µMissionEntryPlan)=>Int match entryPlan{
  µEntryBadgeSpoof()=>41|
  µEntryDuctInsertion()=>24|
  µEntryDockBreach()=>53
}

λfacilityRoomCount(state:µGameState)=>Int=state.activeMission.facility.rooms reduce (λ(count:Int,room:µRoomState)=>Int=count+1) from 0

λhelixgridContract()=>µContractSummary={
  contractId:µContractId("helixgrid-battery-recovery"),
  corporation:µCorporationId("helixgrid"),
  label:"Recover the prototype cryocell battery",
  objective:µStealPrototypeBattery()
}

λinitialCampaignState()=>µCampaignState={
  availableContracts:defaultContracts(),
  completedContracts:[],
  heat:3,
  warehouse:{
    destroyedRobots:[],
    inventory:defaultInventory(),
    robots:defaultRobots()
  }
}

λinitialEventLog(config:µMissionConfigState,contract:µContractSummary)=>[µEventEntry]=[
  {
    message:contractOperationMessage(contract),
    turn:0
  },
  {
    message:entryPlanEventMessage(config.entryPlan),
    turn:1
  }
]

λinitialGameState()=>µGameState=operationState(
  initialCampaignState(),
  defaultMissionConfig(),
  helixgridContract(),
  µShellContractLobby()
)

λinitialMissionState(config:µMissionConfigState,contract:µContractSummary)=>µMissionState={
  alarmLevel:missionAlarmLevel(config),
  contract:contract,
  exposure:entryPlanExposure(config.entryPlan),
  facility:•facilityGenerator.generateFacilityState(missionSeed(
    config,
    contract
  )),
  interrupts:[],
  missionClock:entryPlanMissionClock(config.entryPlan),
  objective:{
    extracted:false,
    kind:contract.objective,
    located:false,
    objectiveId:µObjectiveId("prototype-battery"),
    securedBy:None()
  },
  orders:entryPlanOrders(config.entryPlan),
  robots:entryPlanRobots(config.entryPlan),
  status:µMissionInProgress(),
  trace:entryPlanTrace(config.entryPlan)
}

λmissionAlarmLevel(config:µMissionConfigState)=>µAlarmLevel match config.entryPlan{
  µEntryBadgeSpoof()=>µAlarmSuspicion()|
  µEntryDuctInsertion()=>µAlarmNormal()|
  µEntryDockBreach()=>µAlarmCounterOperatorTrace()
}

λmissionSeed(config:µMissionConfigState,contract:µContractSummary)=>Int=contractBaseSeed(contract)+entryPlanSeedOffset(config.entryPlan)

λmorrowContract()=>µContractSummary={
  contractId:µContractId("morrow-audit-lift"),
  corporation:µCorporationId("morrow-dynamics"),
  label:"Lift the superconducting cryocell from audit storage",
  objective:µStealPrototypeBattery()
}

λnightglassContract()=>µContractSummary={
  contractId:µContractId("nightglass-dawn-snatch"),
  corporation:µCorporationId("nightglass"),
  label:"Snatch the sealed battery sample before dawn",
  objective:µStealPrototypeBattery()
}

λoperationState(campaign:µCampaignState,config:µMissionConfigState,contract:µContractSummary,stage:µShellStage)=>µGameState={
  activeMission:initialMissionState(
    config,
    contract
  ),
  campaign:campaignWithDefaultContracts(campaign),
  eventLog:initialEventLog(
    config,
    contract
  ),
  missionConfig:config,
  schemaVersion:1,
  seed:missionSeed(
    config,
    contract
  ),
  shellStage:stage,
  turn:1
}

λorderCount(state:µGameState)=>Int=state.activeMission.orders reduce (λ(count:Int,robotOrder:µRobotOrder)=>Int=count+1) from 0

λqueuedOrder(order:µOrder,robotId:µRobotId)=>µRobotOrder={
  assignedRobot:robotId,
  order:order,
  status:µOrderQueued()
}

λrosterCount(state:µGameState)=>Int=state.activeMission.robots reduce (λ(count:Int,robot:µRobotState)=>Int=count+1) from 0

λupgradeLegacyCampaign(campaign:µCampaignState)=>µCampaignState={
  availableContracts:defaultContracts(),
  completedContracts:campaign.completedContracts,
  heat:campaign.heat,
  warehouse:campaign.warehouse
}

λupgradeLegacyGameState(state:µLegacyGameState)=>µGameState={
  activeMission:state.activeMission,
  campaign:upgradeLegacyCampaign(state.campaign),
  eventLog:state.eventLog,
  missionConfig:defaultMissionConfig(),
  schemaVersion:state.schemaVersion,
  seed:state.seed,
  shellStage:µShellMissionLive(),
  turn:state.turn
}
