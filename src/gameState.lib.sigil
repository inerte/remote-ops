λdefaultContracts()=>[µContractSummary]=[{
  contractId:µContractId("helixgrid-battery-recovery"),
  corporation:µCorporationId("helixgrid"),
  label:"Recover the prototype cryocell battery",
  objective:µStealPrototypeBattery()
}]

λdefaultInventory()=>[µInventoryItem]=[
  {
    label:"Battery pack",
    partType:µBatteryPack(),
    quantity:2
  },
  {
    label:"Signal relay",
    partType:µSignalRelay(),
    quantity:1
  },
  {
    label:"Spoofed service badge",
    partType:µSpoofedServiceBadge(),
    quantity:1
  }
]

